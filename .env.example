# Copy to .env for local development. Never commit real values.
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO

# Postgres (Supabase). Use the pooled (port 6543) or direct URL; append ?ssl=require for Supabase.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/akam

# RS256 keys as PEM contents. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out priv.pem
#   openssl rsa -in priv.pem -pubout -out pub.pem
# Single-line form uses literal \n. Leave both empty in development for an ephemeral keypair.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000

# Email OTP. OTP_HASH_SECRET: long random string (e.g. `openssl rand -hex 32`).
OTP_HASH_SECRET=
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_REQUESTS_PER_EMAIL=3
OTP_REQUESTS_PER_IP=10
OTP_REQUEST_WINDOW_SECONDS=3600
EMAIL_BACKEND=console          # console (dev only) | smtp | resend
EMAIL_FROM=Akam <no-reply@akam.app>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# Legacy device-only /auth/register (insecure). Keep false.
ENABLE_LEGACY_REGISTER=false

RATE_LIMIT_PER_MINUTE=200

# On-device model manifest served at GET /api/v1/config/models
MODEL_VERSION=
MODEL_URL=
MODEL_SHA256=
MODEL_SIZE_BYTES=0
# GET /api/v1/config/app
MIN_APP_VERSION=1.0.0
FEATURE_FLAGS={}

# Comma-separated explicit origins; '*' is rejected.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CDN_BASE_URL=https://cdn.akam.app
MAX_UPLOAD_SIZE_MB=10

# Deprecated server-side AI (content endpoints)
GEMMA_MODEL_NAME=gemma-4
GEMINI_API_KEY=
GEMMA_API_BASE=
AI_FALLBACK_MODE=true
REDIS_CACHE_TTL_GRAPH=60
REDIS_CACHE_TTL_BRIEFING=21600
REDIS_CACHE_TTL_CLUSTERS=30
